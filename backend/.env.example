# Correo de recuperación de contraseña (valores ficticios; nunca commitear credenciales reales).
# Sin estas variables, POST /auth/forgot-password responde 503 "La recuperación no está disponible temporalmente."
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Plataforma <no-reply@example.test>"
# Base del enlace /reset-password: https en producción; http solo localhost/127.0.0.1 fuera de producción.
FRONTEND_PUBLIC_URL=http://localhost:3000
# Requeridos para habilitar la recuperación (ya presentes en el .env local):
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_PASSWORD_POLICY_V2_ENABLED=true
